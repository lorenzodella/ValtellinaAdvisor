<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:outlineAmbientShadowColor="@color/green_darker">


    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="25dp"
        android:text="Cambio password"
        style="?attr/textAppearanceSearchResultTitle"/>
    
    <GridLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/title"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="20dp">

        <TextView
            android:id="@+id/password_old_desc"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_row="0"
            android:layout_column="0"
            android:text="Vecchia\npassword:"
            android:textSize="18dp"
            android:gravity="right"
            android:layout_gravity="right"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:layout_marginLeft="13dp"
            android:background="@drawable/bg_edittext"
            android:backgroundTint="#e1e1e1">
            <EditText
                android:id="@+id/password_old"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19dp"
                android:inputType="textPassword"
                android:padding="7dp"
                android:layout_marginHorizontal="7dp"
                android:singleLine="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/password_new_desc"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_row="1"
            android:layout_column="0"
            android:text="Nuova\npassword:"
            android:textSize="18dp"
            android:gravity="right"
            android:layout_gravity="right"
            android:layout_marginTop="10dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:layout_marginLeft="13dp"
            android:background="@drawable/bg_edittext"
            android:backgroundTint="#e1e1e1"
            android:layout_marginTop="10dp">
            <EditText
                android:id="@+id/password_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19dp"
                android:inputType="textPassword"
                android:padding="7dp"
                android:layout_marginHorizontal="7dp"
                android:singleLine="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/password_conf_desc"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_row="2"
            android:layout_column="0"
            android:text="Conferma\npassword:"
            android:textSize="18dp"
            android:gravity="right"
            android:layout_gravity="right"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_gravity="fill_horizontal|center_vertical"
            android:layout_marginLeft="13dp"
            android:background="@drawable/bg_edittext"
            android:backgroundTint="#e1e1e1">
            <EditText
                android:id="@+id/password_conf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19dp"
                android:inputType="textPassword"
                android:padding="7dp"
                android:layout_marginHorizontal="7dp"
                android:singleLine="true"/>
        </LinearLayout>

    </GridLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/grid"
        android:visibility="gone"/>

</RelativeLayout>