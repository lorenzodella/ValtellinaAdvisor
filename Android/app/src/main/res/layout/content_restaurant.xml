<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".restaurant.RestaurantActivity"
    tools:showIn="@layout/activity_restaurant"
    android:background="#E1E1E1">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp">

        <GridLayout
            android:id="@+id/dati"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="6"
            android:useDefaultMargins="true"
            android:alignmentMode="alignBounds"
            android:columnOrderPreserved="false"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/indirizzo_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indirizzo: "
                android:textStyle="bold"
                android:textSize="22dp"
                android:fontFamily="cursive"
                android:textColor="@color/black"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/indirizzo"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="Via Roma 10"
                android:textSize="15dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/black"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/citta_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Città: "
                android:textStyle="bold"
                android:textSize="22dp"
                android:fontFamily="cursive"
                android:textColor="@color/black"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/citta"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="Traona - Sondrio"
                android:textSize="15dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/black"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/coordinate_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coordinate: "
                android:textStyle="bold"
                android:textSize="22dp"
                android:fontFamily="cursive"
                android:textColor="@color/black"
                android:layout_row="2"
                android:layout_column="0"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/coordinate"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="46.55667, 9.88776"
                android:textSize="15dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/black"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/telefono_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Telefono: "
                android:textStyle="bold"
                android:textSize="22dp"
                android:fontFamily="cursive"
                android:textColor="@color/black"
                android:layout_row="3"
                android:layout_column="0"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/telefono"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="3334445555"
                android:textSize="15dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/black"
                android:layout_row="3"
                android:layout_column="1"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/categoria_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoria: "
                android:textStyle="bold"
                android:textSize="22dp"
                android:fontFamily="cursive"
                android:textColor="@color/black"
                android:layout_row="4"
                android:layout_column="0"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/categoria"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:text="Alberghi - Ristoranti"
                android:textSize="15dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/black"
                android:layout_row="4"
                android:layout_column="1"
                android:layout_marginHorizontal="5dp"/>

            <TextView
                android:id="@+id/rating_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rating: "
                android:textStyle="bold"
                android:textSize="22dp"
                android:fontFamily="cursive"
                android:textColor="@color/black"
                android:layout_row="5"
                android:layout_column="0"
                android:layout_marginHorizontal="5dp"/>

            <RatingBar
                android:id="@+id/rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.AppCompat.RatingBar.Indicator"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.1"
                android:progressTint="@color/green_dark"
                android:secondaryProgressTint="#00000000"
                android:layout_row="5"
                android:layout_column="1"
                android:layout_marginHorizontal="5dp"/>

        </GridLayout>

        <TextView
            android:id="@+id/recensioni_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recensioni"
            android:textStyle="bold"
            android:textSize="27dp"
            android:fontFamily="cursive"
            android:textColor="@color/black"
            android:layout_below="@id/dati"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"/>

        <TextView
            android:id="@+id/no_recensioni"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nessuna recensione"
            android:layout_below="@id/recensioni_desc"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="60dp"/>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleY=".6"
            android:scaleX=".6"
            android:text="Nessuna recensione"
            android:layout_below="@id/recensioni_desc"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="60dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_recensioni"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/recensioni_desc"
            android:layout_marginTop="10dp"
            android:layoutAnimation="@anim/layout_animation"
            android:layout_marginBottom="40dp"/>
        
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>